SELECT * 
FROM ComputorStore 
WHERE price > 100 AND stock_quantity > 0;

SELECT * 
FROM ComputorStore 
WHERE product_name LIKE '%Laptop%';

SELECT 
    MIN(price) AS lowest_price, 
    MAX(price) AS highest_price 
FROM ComputorStore;

