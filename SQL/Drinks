SELECT * FROM Drinks
WHERE Price = (SELECT min(Price) FROM Drinks);

SELECT * FROM Drinks
WHERE Price = (SELECT max(Price) FROM Drinks);

SELECT SUM(Price) AS TotalPrice FROM Drinks;

SELECT AVG(Price) AS AveragePrice FROM Drinks;

SELECT COUNT(*) AS TotalDrinks FROM Drinks;