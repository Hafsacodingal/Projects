SELECT DISTINCT animal_group 
FROM marine_observations;

SELECT COUNT(*) 
FROM marine_observations 
WHERE animal_group = 'Mammal';

SELECT 
    SUM(estimated_weight_kg) AS total_estimated_weight,
    AVG(depth_meters) AS average_depth
FROM marine_observations;
