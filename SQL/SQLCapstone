CREATE TABLE IF NOT EXISTS salesman(
    salesman_id INT PRIMARY KEY,
    Name TEXT,
    City TEXT,
    Commission TEXT
);

CREATE TABLE IF NOT EXISTS Customer(
    customer_id INT PRIMARY KEY,
    Name TEXT,
    City TEXT,
    Grade TEXT,
    salesman_id TEXT
);

CREATE TABLE IF NOT EXISTS Order(
    customer_id TEXT,
    salesman_id TEXT,
    City TEXT
)

