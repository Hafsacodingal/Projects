SELECT * FROM zoo_animal;

SELECT Species FROM zoo_animal;

SELECT DISTINCT Species FROM zoo_animal;

SELECT COUNT(DISTINCT Species) AS Unique_Species FROM zoo_animal;

SELECT COUNT(AnimalID) AS Total_Animals FROM zoo_animal;

SELECT COUNT(AnimalID) AS Older_Animals FROM zoo_animal
WHERE age_year > 5;

SELECT SUM(weight_kg) AS Total_Weight FROM zoo_animal;

SELECT AVG(age_year) AS Average_Age FROM zoo_animal;

SELECT 
    COUNT(AnimalID) AS Total_Animals,
    COUNT(DISTINCT Species) AS Unique_Species,
    SUM(weight_kg) AS Total_Weight, 
    AVG(age_year) AS Average_Age
FROM zoo_animal;
