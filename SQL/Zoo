CREATE TABLE If not EXISTS zoo_animal (
    AnimalID INT PRIMARY KEY,
    Name TEXT NOT NULL,
    Species TEXT NOT NULL,
    age_year INTEGER NOT NULL,
    weight_kg TEXT
);

